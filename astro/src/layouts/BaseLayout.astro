---
export interface Props {
  title?: string;
  description?: string;
}
const { title = '80F Creative', description = 'Creative agency portfolio' } = Astro.props as Props;
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="stylesheet" href="/src/styles/global.css">
  </head>
  <body>
    <header class="site-header">
      <div class="container">
        <div class="pill" style="display:flex;justify-content:space-between;align-items:center;gap:1rem;">
          <a href="/" style="font-weight:800;">80F Creative</a>
          <nav style="display:none;gap:1.25rem;" class="desktop-nav">
            <a href="/work">Work</a>
            <a href="/photography">Photography</a>
            <a href="/services/">Services</a>
            <a href="/about">About</a>
            <a href="/contact">Contact</a>
          </nav>
        </div>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container">
        <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:1rem;">
          <div>© {new Date().getFullYear()} 80F Creative</div>
          <nav style="display:flex;gap:1rem;">
            <a href="/work">Work</a>
            <a href="/photography">Photography</a>
            <a href="/services/">Services</a>
            <a href="/about">About</a>
            <a href="/contact">Contact</a>
          </nav>
        </div>
      </div>
    </footer>
  </body>
  <style>
    @media (min-width: 900px){ .desktop-nav{ display:flex !important } }
  </style>
  <script>
    // Optional: insert small nav interactions here if needed
  </script>
  </html>
