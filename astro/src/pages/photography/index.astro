---
import BaseLayout from "../../layouts/BaseLayout.astro";

const photoCategories = [
  { name: "All", path: "/photography" },
  { name: "Outdoor", path: "/photography/outdoor" },
  { name: "Musician", path: "/photography/musician" }
];

const currentPath = Astro.url.pathname;
---

<BaseLayout title="Photography — 80F Creative" description="Outdoor adventure, music, and lifestyle photography.">
  <section class="hero" style="padding-top:3rem">
    <div class="container">
      <h1 style="font-weight:800;font-size:2.5rem">Photography</h1>
      <p style="opacity:.8;max-width:600px;margin:1rem auto">Capturing authentic moments across outdoor adventures, music scenes, and lifestyle stories.</p>
      <div style="display:flex;flex-wrap:wrap;justify-content:center;gap:.75rem;margin-top:1.5rem">
        {photoCategories.map(cat => (
          <a class="btn" href={cat.path} style={currentPath === cat.path ? 'background:var(--color-accent);color:white' : ''}>{cat.name}</a>
        ))}
      </div>
    </div>
  </section>
  
  <section style="padding:3rem 0">
    <div class="container">
      <div class="grid grid-3">
        <a href="/photography/outdoor" class="pill" style="text-decoration:none;position:relative;overflow:hidden;padding:0">
          <div style="aspect-ratio:1;overflow:hidden">
            <img src="/outdoor-photography/outdoor1.jpg" alt="Outdoor Photography" style="width:100%;height:100%;object-fit:cover;transition:transform .3s" />
          </div>
          <div style="padding:1rem">
            <strong style="display:block;font-size:1.25rem">Outdoor & Adventure</strong>
            <div style="opacity:.8;font-size:.9rem;margin-top:.5rem">71 photos</div>
          </div>
        </a>
        
        <a href="/photography/musician" class="pill" style="text-decoration:none;position:relative;overflow:hidden;padding:0">
          <div style="aspect-ratio:1;overflow:hidden">
            <img src="/music-photography/music1.jpg" alt="Music Photography" style="width:100%;height:100%;object-fit:cover;transition:transform .3s" />
          </div>
          <div style="padding:1rem">
            <strong style="display:block;font-size:1.25rem">Music & Musicians</strong>
            <div style="opacity:.8;font-size:.9rem;margin-top:.5rem">40 photos</div>
          </div>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .pill:hover img {
    transform: scale(1.05);
  }
  .pill:hover {
    transform: translateY(-2px);
    transition: transform .2s;
  }
</style>
