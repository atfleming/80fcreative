---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { readdir } from "node:fs/promises";
import { join } from "node:path";

const photosDir = join(process.cwd(), "public", "music-photography");
const files = await readdir(photosDir);
const images = files
  .filter(f => /\.(jpg|jpeg|png|webp|avif)$/i.test(f))
  .map(f => `/music-photography/${f}`);

const photoCategories = [
  { name: "All", path: "/photography" },
  { name: "Outdoor", path: "/photography/outdoor" },
  { name: "Musician", path: "/photography/musician" }
];
---

<BaseLayout title="Musician Photography — 80F Creative" description="Music scene and musician portrait photography.">
  <section class="hero" style="padding-top:3rem">
    <div class="container">
      <h1 style="font-weight:800;font-size:2.5rem">Musician Photography</h1>
      <p style="opacity:.8;max-width:600px;margin:1rem auto">{images.length} photos from live performances, studio sessions, and artist portraits.</p>
      <div style="display:flex;flex-wrap:wrap;justify-content:center;gap:.75rem;margin-top:1.5rem">
        {photoCategories.map(cat => (
          <a class="btn" href={cat.path} style={cat.name === 'Musician' ? 'background:var(--color-accent);color:white' : ''}>{cat.name}</a>
        ))}
      </div>
    </div>
  </section>
  
  <section style="padding:3rem 0">
    <div class="container">
      <div class="grid grid-4">
        {images.map((img, i) => (
          <button 
            class="photo-card"
            data-index={i}
            style="position:relative;overflow:hidden;padding:0;border:none;cursor:pointer;background:none;border-radius:24px"
          >
            <div style="aspect-ratio:4/3;overflow:hidden;width:100%">
              <img src={img} alt={`Music photo ${i + 1}`} style="width:100%;height:100%;object-fit:cover;transition:transform .3s" class="photo-img" loading="lazy" />
            </div>
          </button>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .photo-card:hover .photo-img {
    transform: scale(1.05);
  }
  .photo-card:hover {
    transform: translateY(-2px);
    transition: transform .2s;
  }
</style>

<script define:vars={{ images }}>
  document.querySelectorAll('.photo-card').forEach(card => {
    card.addEventListener('click', () => {
      const index = parseInt(card.getAttribute('data-index') || '0');
      openLightbox(index);
    });
  });
  
  function openLightbox(startIndex) {
    let currentIndex = startIndex;
    
    const modal = document.createElement('div');
    modal.innerHTML = `
      <div style="position:fixed;inset:0;background:rgba(0,0,0,0.95);display:flex;align-items:center;justify-content:center;z-index:9999;padding:1rem" id="photo-modal">
        <button style="position:absolute;top:50%;left:1rem;transform:translateY(-50%);background:rgba(255,255,255,0.1);border:none;color:white;font-size:2rem;cursor:pointer;padding:1rem;border-radius:50%;width:3rem;height:3rem;display:flex;align-items:center;justify-content:center" id="prev-photo">‹</button>
        <button style="position:absolute;top:50%;right:1rem;transform:translateY(-50%);background:rgba(255,255,255,0.1);border:none;color:white;font-size:2rem;cursor:pointer;padding:1rem;border-radius:50%;width:3rem;height:3rem;display:flex;align-items:center;justify-content:center" id="next-photo">›</button>
        <button style="position:absolute;top:1rem;right:1rem;background:none;border:none;color:white;font-size:3rem;cursor:pointer;line-height:1;opacity:.8" id="close-modal">&times;</button>
        <img id="lightbox-img" style="max-width:90%;max-height:90%;object-fit:contain" />
        <div style="position:absolute;bottom:1rem;left:50%;transform:translateX(-50%);color:white;font-size:.9rem" id="photo-counter"></div>
      </div>
    `;
    
    document.body.appendChild(modal);
    
    const img = document.getElementById('lightbox-img');
    const counter = document.getElementById('photo-counter');
    
    function updatePhoto() {
      if (img && counter) {
        img.src = images[currentIndex];
        counter.textContent = `${currentIndex + 1} / ${images.length}`;
      }
    }
    
    updatePhoto();
    
    document.getElementById('prev-photo')?.addEventListener('click', () => {
      currentIndex = (currentIndex - 1 + images.length) % images.length;
      updatePhoto();
    });
    
    document.getElementById('next-photo')?.addEventListener('click', () => {
      currentIndex = (currentIndex + 1) % images.length;
      updatePhoto();
    });
    
    const closeModal = () => modal.remove();
    document.getElementById('close-modal')?.addEventListener('click', closeModal);
    document.getElementById('photo-modal')?.addEventListener('click', (e) => {
      if (e.target.id === 'photo-modal') closeModal();
    });
    
    document.addEventListener('keydown', function handleKey(e) {
      if (e.key === 'Escape') {
        closeModal();
        document.removeEventListener('keydown', handleKey);
      } else if (e.key === 'ArrowLeft') {
        currentIndex = (currentIndex - 1 + images.length) % images.length;
        updatePhoto();
      } else if (e.key === 'ArrowRight') {
        currentIndex = (currentIndex + 1) % images.length;
        updatePhoto();
      }
    });
  }
</script>
