---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from 'astro:content';
const featured = (await getCollection('case-studies')).slice(0, 2);
---
<BaseLayout title="80F Creative — Portfolio">
  <section class="hero">
    <div class="container">
      <h1 style="font-weight:900;font-size:clamp(2rem,5vw,3.5rem);margin:0 0 .5rem">Creative Work That Moves</h1>
      <p style="max-width:60ch;margin:0 auto 2rem;font-size:1.125rem;opacity:.85">Videography, photography, and branded storytelling for teams that need compelling campaigns and measurable results.</p>
      <div style="display:flex;justify-content:center;gap:.75rem;flex-wrap:wrap">
        <a class="btn" href="/projects/">View Work</a>
        <a class="btn" href="/contact">Start a Project</a>
      </div>
    </div>
  </section>

  <section style="padding:4rem 0">
    <div class="container">
      <h2 style="font-size:1.75rem;margin-bottom:1.5rem;font-weight:700">Featured Case Studies</h2>
      <div class="grid grid-2">
        {featured.map((study) => (
          <a href={`/projects/${study.slug}`} class="pill" style="display:block;transition:transform .2s;text-decoration:none" onmouseover="this.style.transform='translateY(-2px)'" onmouseout="this.style.transform='translateY(0)'">
            <strong style="font-size:1.125rem">{study.data.title.replace('Case Study: ', '').replace('Featured Case Study: ', '')}</strong>
            {study.data.excerpt && (<div style="opacity:.75;margin-top:.25rem;font-size:.9rem">{study.data.excerpt}</div>)}
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
