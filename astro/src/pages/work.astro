---
import BaseLayout from "../layouts/BaseLayout.astro";
import { portfolioItems, categories } from "../data/portfolio";

const url = new URL(Astro.request.url);
const filterParam = url.searchParams.get('filter') || 'All';

const filteredItems = filterParam === 'All' 
  ? portfolioItems 
  : portfolioItems.filter(item => item.category === filterParam);
---

<BaseLayout title="Video Projects — 80F Creative" description="Commercial, documentary, music videos, and narrative film work.">
  <section class="hero" style="padding-top:3rem">
    <div class="container">
      <h1 style="font-weight:800;font-size:2.5rem">Video Projects</h1>
      <div style="display:flex;flex-wrap:wrap;justify-content:center;gap:.75rem;margin-top:1.5rem">
        <a class="btn" href="/work" style={filterParam === 'All' ? 'background:var(--color-accent);color:white' : ''}>All</a>
        {categories.map(cat => (
          <a class="btn" href={`/work?filter=${cat}`} style={filterParam === cat ? 'background:var(--color-accent);color:white' : ''}>{cat}</a>
        ))}
      </div>
    </div>
  </section>
  
  <section style="padding:3rem 0">
    <div class="container">
      <div class="grid grid-3">
        {filteredItems.map((item) => (
          <button 
            class="pill portfolio-card"
            data-video-id={item.videoId}
            data-is-vimeo={item.isVimeo}
            data-title={item.title}
            data-external={item.externalLink}
            style="position:relative;overflow:hidden;padding:0;border:none;cursor:pointer;text-align:left"
          >
            <div style="aspect-ratio:1;overflow:hidden">
              <img src={item.image} alt={item.title} style="width:100%;height:100%;object-fit:cover;transition:transform .3s" class="card-img" />
            </div>
            <div style="padding:1rem">
              <div style="font-size:.75rem;opacity:.7;margin-bottom:.25rem">{item.category}</div>
              <strong style="display:block;font-size:1rem">{item.title}</strong>
              {item.description && <div style="opacity:.8;font-size:.85rem;margin-top:.25rem">{item.description}</div>}
            </div>
            {item.videoId && (
              <div class="play-icon" style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);pointer-events:none">
                <svg width="48" height="48" viewBox="0 0 48 48" fill="white" opacity="0.9">
                  <circle cx="24" cy="24" r="24" fill="var(--color-accent)"/>
                  <path d="M18 14l14 10-14 10z" fill="white"/>
                </svg>
              </div>
            )}
          </button>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .portfolio-card:hover .card-img {
    transform: scale(1.05);
  }
  .portfolio-card:hover {
    transform: translateY(-2px);
    transition: transform .2s;
  }
</style>

<script>
  document.querySelectorAll('.portfolio-card').forEach(card => {
    card.addEventListener('click', () => {
      const videoId = card.getAttribute('data-video-id');
      const isVimeo = card.getAttribute('data-is-vimeo') === 'true';
      const title = card.getAttribute('data-title') || '';
      const external = card.getAttribute('data-external');
      
      if (external) {
        window.open(external, '_blank');
        return;
      }
      
      if (!videoId) return;
      
      const embedUrl = isVimeo 
        ? `https://player.vimeo.com/video/${videoId}?autoplay=1`
        : `https://www.youtube.com/embed/${videoId}?autoplay=1`;
      
      const modal = document.createElement('div');
      modal.innerHTML = `
        <div style="position:fixed;inset:0;background:rgba(0,0,0,0.95);display:flex;align-items:center;justify-content:center;z-index:9999;padding:1rem" id="video-modal">
          <div style="position:relative;width:100%;max-width:1200px">
            <button style="position:absolute;top:-3rem;right:0;background:none;border:none;color:white;font-size:3rem;cursor:pointer;line-height:1;opacity:.8" id="close-modal">&times;</button>
            <div style="position:relative;padding-bottom:56.25%;height:0;overflow:hidden;background:#000;border-radius:12px">
              <iframe src="${embedUrl}" title="${title}" style="position:absolute;top:0;left:0;width:100%;height:100%" frameborder="0" allow="accelerometer;autoplay;clipboard-write;encrypted-media;gyroscope;picture-in-picture" allowfullscreen></iframe>
            </div>
          </div>
        </div>
      `;
      
      document.body.appendChild(modal);
      
      const closeModal = () => modal.remove();
      document.getElementById('close-modal')?.addEventListener('click', closeModal);
      document.getElementById('video-modal')?.addEventListener('click', (e) => {
        if (e.target.id === 'video-modal') closeModal();
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeModal();
      }, { once: true });
    });
  });
</script>
