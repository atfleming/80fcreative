---
import BaseLayout from "../layouts/BaseLayout.astro";
import { readdir } from "node:fs/promises";
import { join } from "node:path";

// Read design files
const designDir = join(process.cwd(), "public", "design");
const designFiles = await readdir(designDir);
const designImages = designFiles
  .filter(f => /\.(jpg|jpeg|png|webp|avif)$/i.test(f))
  .map(f => ({ path: `/design/${f}`, name: f.replace(/\.(jpg|jpeg|png|webp|avif)$/i, "") }));
---

<BaseLayout title="Design — 80F Creative" description="Graphic design, branding, and visual identity work.">
  {/* Hero Section */}
  <section style="position:relative;height:60vh;overflow:hidden;display:flex;align-items:center;justify-content:center">
    <div style="position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,0.5) 0%,rgba(0,0,0,0.7) 100%);z-index:10"></div>
    <img 
      src="/design/80fcreativelogo.png" 
      alt="Design Hero" 
      style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:1"
    />
    <div style="position:relative;z-index:20;text-align:center;color:white">
      <h1 style="font-weight:800;font-size:3rem;margin:0;text-shadow:0 2px 10px rgba(0,0,0,0.5)">Design</h1>
      <p style="font-size:1.1rem;opacity:0.9;margin-top:1rem;max-width:600px">Graphic design, branding, and visual identity work that brings ideas to life.</p>
    </div>
  </section>

  {/* Design Gallery */}
  <section style="padding:3rem 0;background:var(--color-bg)">
    <div class="container">
      {/* Design Grid */}
      <div id="design-grid" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:1.5rem;width:100%">
        {designImages.map((design, i) => (
          <button 
            class="design-card"
            data-index={i}
            style="position:relative;overflow:hidden;padding:0;border:none;cursor:pointer;background:none;border-radius:24px;aspect-ratio:4/3"
          >
            <img 
              src={design.path} 
              alt={design.name} 
              style="width:100%;height:100%;object-fit:cover;transition:transform .3s;filter:brightness(0.75)" 
              class="design-img" 
              loading="lazy" 
            />
          </button>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .design-card:hover .design-img {
    transform: scale(1.05);
  }
</style>

<script>
  // Add lightbox functionality
  document.querySelectorAll('.design-card').forEach(card => {
    card.addEventListener('click', () => {
      const index = parseInt(card.getAttribute('data-index') || '0');
      openLightbox(index);
    });
  });

  function openLightbox(startIndex) {
    let currentIndex = startIndex;
    const allCards = document.querySelectorAll('.design-card');
    const allImages = Array.from(allCards).map(card => card.querySelector('img').src);
    
    const modal = document.createElement('div');
    modal.innerHTML = `
      <div style="position:fixed;inset:0;background:rgba(0,0,0,0.95);display:flex;align-items:center;justify-content:center;z-index:9999;padding:1rem" id="design-modal">
        <button style="position:absolute;top:50%;left:1rem;transform:translateY(-50%);background:rgba(255,255,255,0.1);border:none;color:white;font-size:2rem;cursor:pointer;padding:1rem;border-radius:50%;width:3rem;height:3rem;display:flex;align-items:center;justify-content:center" id="prev-design">‹</button>
        <button style="position:absolute;top:50%;right:1rem;transform:translateY(-50%);background:rgba(255,255,255,0.1);border:none;color:white;font-size:2rem;cursor:pointer;padding:1rem;border-radius:50%;width:3rem;height:3rem;display:flex;align-items:center;justify-content:center" id="next-design">›</button>
        <button style="position:absolute;top:1rem;right:1rem;background:none;border:none;color:white;font-size:3rem;cursor:pointer;line-height:1;opacity:.8" id="close-modal">&times;</button>
        <img id="lightbox-img" style="max-width:90%;max-height:90%;object-fit:contain" />
        <div style="position:absolute;bottom:1rem;left:50%;transform:translateX(-50%);color:white;font-size:.9rem" id="design-counter"></div>
      </div>
    `;
    
    document.body.appendChild(modal);
    
    function updateLightbox() {
      const img = document.getElementById('lightbox-img');
      img.src = allImages[currentIndex];
      document.getElementById('design-counter').textContent = `${currentIndex + 1} of ${allImages.length}`;
    }
    
    updateLightbox();
    
    document.getElementById('next-design')?.addEventListener('click', () => {
      currentIndex = (currentIndex + 1) % allImages.length;
      updateLightbox();
    });
    
    document.getElementById('prev-design')?.addEventListener('click', () => {
      currentIndex = (currentIndex - 1 + allImages.length) % allImages.length;
      updateLightbox();
    });
    
    const closeModal = () => modal.remove();
    document.getElementById('close-modal')?.addEventListener('click', closeModal);
    document.getElementById('design-modal')?.addEventListener('click', (e) => {
      if (e.target.id === 'design-modal') closeModal();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeModal();
      if (e.key === 'ArrowRight') document.getElementById('next-design')?.click();
      if (e.key === 'ArrowLeft') document.getElementById('prev-design')?.click();
    });
  }
</script>
