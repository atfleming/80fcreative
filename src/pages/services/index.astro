---
import BaseLayout from "../../layouts/BaseLayout.astro";
---
<BaseLayout title="Services — 80F Creative" description="Full-stack creative support from concept to final delivery.">
  <section class="hero" style="padding-top:3rem">
    <div class="container">
      <h1 style="font-weight:800;font-size:2.5rem">Creative Services</h1>
      <p style="max-width:48rem;margin:1rem auto 0;font-size:1.125rem;opacity:.85">Full-stack creative support: from concept to multi-platform distribution.</p>
    </div>
  </section>
  <section style="padding:3rem 0">
    <div class="container">
      <div class="grid grid-3">
        <div class="pill" style="padding:1.5rem;text-align:center">
          <div style="font-size:2rem;margin-bottom:.5rem">🎬</div>
          <strong style="display:block;margin-bottom:.5rem;font-size:1.125rem">Video Production</strong>
          <div style="opacity:.8;font-size:.9rem">Commercials, branded content, and documentary-style storytelling.</div>
        </div>
        <div class="pill" style="padding:1.5rem;text-align:center">
          <div style="font-size:2rem;margin-bottom:.5rem">📸</div>
          <strong style="display:block;margin-bottom:.5rem;font-size:1.125rem">Photography</strong>
          <div style="opacity:.8;font-size:.9rem">Lifestyle, outdoor, and musician portraiture for campaigns and artists.</div>
        </div>
        <div class="pill" style="padding:1.5rem;text-align:center">
          <div style="font-size:2rem;margin-bottom:.5rem">✏️</div>
          <strong style="display:block;margin-bottom:.5rem;font-size:1.125rem">Creative Direction</strong>
          <div style="opacity:.8;font-size:.9rem">Concept development, art direction, and campaign strategy.</div>
        </div>
        <div class="pill" style="padding:1.5rem;text-align:center">
          <div style="font-size:2rem;margin-bottom:.5rem">🎨</div>
          <strong style="display:block;margin-bottom:.5rem;font-size:1.125rem">Design/Web Development</strong>
          <div style="opacity:.8;font-size:.9rem">Brand identity, digital design, and development services.</div>
        </div>
        <div class="pill" style="padding:1.5rem;text-align:center">
          <div style="font-size:2rem;margin-bottom:.5rem">✂️</div>
          <strong style="display:block;margin-bottom:.5rem;font-size:1.125rem">Editing</strong>
          <div style="opacity:.8;font-size:.9rem">Post-production, color grading, and motion graphics.</div>
        </div>
      </div>
      <div style="text-align:center;margin-top:3rem">
        <h3 style="font-weight:700;font-size:1.5rem;margin-bottom:1rem">Ready to get started?</h3>
        <a class="btn" href="/contact">Start a Project</a>
      </div>
    </div>
  </section>
</BaseLayout>
